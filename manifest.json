{
  "manifest_version": 3,
  "name": "FormForge — AI QA Form Filler",
  "version": "1.0.3",
  "description": "Fills any form with coherent QA test data in one click — custom dropdowns, date pickers and editors included. On-device AI.",
  "minimum_chrome_version": "128",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "src/popup.html",
    "default_title": "FormForge (Alt+Shift+F fills the form, Alt+Shift+D the focused field)"
  },
  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill the page with test data"
    },
    "fill-field": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Fill the focused field"
    },
    "refill-form": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Fill again with a new persona"
    },
    "clear-form": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Clear all filled fields"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  }
}
